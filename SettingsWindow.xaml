<Window x:Class="Asker.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root"
        Title="Asker Settings" Icon="Asker.ico" Width="860" Height="680" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
    <WindowChrome.WindowChrome>
        <!-- Custom title bar: the top 40px drags/double-click maximizes; 6px resize border. -->
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaption" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <!-- A maximized chromeless window overhangs the screen by the resize border; pull content back in. -->
                    <DataTrigger Binding="{Binding WindowState, ElementName=Root}" Value="Maximized">
                        <Setter Property="Margin" Value="7"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaption}" Content="&#xE8BB;" Click="OnCloseWindow"
                    ToolTip="Close" AutomationProperties.Name="Close"/>
            <Button DockPanel.Dock="Right" Click="OnMaximize" AutomationProperties.Name="Maximize">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                        <Setter Property="Content" Value="&#xE922;"/>
                        <Setter Property="ToolTip" Value="Maximize"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowState, ElementName=Root}" Value="Maximized">
                                <Setter Property="Content" Value="&#xE923;"/>
                                <Setter Property="ToolTip" Value="Restore"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize"
                    ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
            <Image Source="Asker.ico" Width="16" Height="16" Margin="16,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="Asker" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="28,8,28,20">
                <TextBlock Text="Settings" Style="{StaticResource Title}"/>
                <TextBlock Text="Copy any text, press a hotkey, and get an answer in the result window." Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,20"/>

                <!-- Connection -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Nous Portal API key" Style="{StaticResource Heading}"/>
                        <TextBlock Text="Stored encrypted, readable only by your Windows account." Style="{StaticResource Caption}" Margin="0,2,0,10"/>
                        <PasswordBox x:Name="KeyBox" LostFocus="OnKeyChanged" AutomationProperties.Name="Nous Portal API key"/>
                    </StackPanel>
                </Border>

                <!-- General -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,4">
                    <StackPanel>
                        <DockPanel Margin="0,12">
                            <TextBox x:Name="ToggleBox" DockPanel.Dock="Right" Width="160" IsReadOnly="True" Cursor="Hand"
                                     PreviewKeyDown="OnHotkeyKey" AutomationProperties.Name="Show or hide result window hotkey"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Show / hide result window" Style="{StaticResource Heading}"/>
                                <TextBlock Text="Click the box and press a key combination." Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource Line}"/>
                        <DockPanel Margin="0,12">
                            <CheckBox x:Name="StartupBox" DockPanel.Dock="Right" VerticalAlignment="Center" AutomationProperties.Name="Start with Windows"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Start with Windows" Style="{StaticResource Heading}"/>
                                <TextBlock Text="Run Asker in the tray when you sign in." Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource Line}"/>
                        <DockPanel Margin="0,12">
                            <CheckBox x:Name="HideCaptureBox" DockPanel.Dock="Right" VerticalAlignment="Center" AutomationProperties.Name="Hide from screen sharing"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Hide from screen sharing" Style="{StaticResource Heading}"/>
                                <TextBlock Text="Asker windows stay visible to you but are left out of screen shares, screenshots and recordings." Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource Line}"/>
                        <DockPanel Margin="0,12">
                            <!-- Editable+ReadOnly: pick-only, but shows the choice in the shared ComboBox template's text area. -->
                            <ComboBox x:Name="RetentionBox" DockPanel.Dock="Right" Width="160" IsReadOnly="True" VerticalAlignment="Center"
                                      AutomationProperties.Name="Delete history after">
                                <ComboBoxItem Content="Never"/>
                                <ComboBoxItem Content="1 day"/>
                                <ComboBoxItem Content="7 days"/>
                                <ComboBoxItem Content="30 days"/>
                                <ComboBoxItem Content="90 days"/>
                            </ComboBox>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Delete history after" Style="{StaticResource Heading}"/>
                                <TextBlock Text="History is stored encrypted on this PC. Pinned results are always kept." Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Hotkeys -->
                <DockPanel Margin="0,28,0,10">
                    <Button DockPanel.Dock="Right" Click="OnAdd" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Add hotkey"/>
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="Hotkeys" Style="{StaticResource Heading}" FontSize="16"/>
                        <TextBlock Text="Each hotkey sends your clipboard to a model with its own prompt. Backspace clears a hotkey box." Style="{StaticResource Caption}"/>
                    </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource Card}" Padding="16,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="HOTKEY" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="MODEL" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="PROMPT" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                        </Grid>
                        <ItemsControl x:Name="List" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="210"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Hotkey, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"
                                                 PreviewKeyDown="OnHotkeyKey" VerticalAlignment="Top" Cursor="Hand" FontWeight="SemiBold"
                                                 AutomationProperties.Name="Hotkey"/>
                                        <ComboBox Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top"
                                                  ItemsSource="{Binding Models, ElementName=Root}"
                                                  Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Model"/>
                                        <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"
                                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Prompt"/>
                                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE74D;" HorizontalAlignment="Right"
                                                VerticalAlignment="Top" Margin="0,3,0,0" Click="OnRemove" ToolTip="Remove hotkey" AutomationProperties.Name="Remove hotkey"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No hotkeys yet. Add one to get started." FontSize="13"
                                   HorizontalAlignment="Center" Margin="0,16,0,20">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=List}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="28,14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource Primary}" Click="OnSave" IsDefault="True" Margin="8,0,0,0" MinWidth="88"/>
                <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" MinWidth="88"/>
                <TextBlock x:Name="Error" Foreground="{DynamicResource Danger}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                           AutomationProperties.LiveSetting="Assertive"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
