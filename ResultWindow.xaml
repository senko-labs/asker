<Window x:Class="Asker.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asker" Icon="Asker.ico" Width="800" Height="520" MinWidth="360" MinHeight="160"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        MouseLeftButtonDown="OnDrag" KeyDown="OnKey">
    <WindowChrome.WindowChrome>
        <!-- No caption; 6px resize border on every edge and corner. -->
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Full-height collapse/expand strip on the left of the question and answer blocks. -->
        <Style x:Key="Collapser" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Padding" Value="0,7,0,0"/>
        </Style>

        <!-- Day separator pill (Slack-style); click for the jump menu. -->
        <Style x:Key="DatePill" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Bg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,3"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="ToolTip" Value="Jump to…"/>
            <Setter Property="AutomationProperties.Name" Value="Jump to date"/>
        </Style>

        <!-- Pinned list, expanded: title + answer preview; double-click renames; unpin on hover. -->
        <DataTemplate x:Key="PinnedFull">
                                    <!-- Double-click to rename: the card swaps to a text box. -->
                                    <Grid Margin="0,0,0,2" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Click="OnPinnedClick" MouseDoubleClick="OnRenameStart"
                                                ToolTip="{Binding Title}" AutomationProperties.Name="{Binding DisplayName}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ListButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Renaming}" Value="True">
                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" MaxHeight="20" FontSize="13"/>
                                                <TextBlock Text="{Binding ResultPreview}" TextTrimming="CharacterEllipsis" MaxHeight="18"
                                                           Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- Unpin: shown while the pointer is over the item. -->
                                        <Button Grid.Column="1" Content="&#xE77A;" Click="OnPin" VerticalAlignment="Center"
                                                ToolTip="Unpin" AutomationProperties.Name="Unpin">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True"/>
                                                                <Condition Binding="{Binding Renaming}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <TextBox Grid.ColumnSpan="2" VerticalAlignment="Center" KeyDown="OnRenameKey" LostKeyboardFocus="OnRenameLostFocus"
                                                 AutomationProperties.Name="Rename pinned item">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Renaming}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>
                                </DataTemplate>

        <!-- Pinned list, collapsed: a square button with the title's first letter. -->
        <DataTemplate x:Key="PinnedCompact">
            <Button Click="OnPinnedClick" Width="32" Height="32" Padding="0" Margin="0,0,0,6" HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    ToolTip="{Binding DisplayName}" AutomationProperties.Name="{Binding DisplayName}">
                <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="13"/>
            </Button>
        </DataTemplate>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Pinned units; click one to scroll to it. Hidden while nothing is pinned. -->
            <Border x:Name="Sidebar" Width="200" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="0,0,1,0" Visibility="Collapsed">
                <DockPanel>
                    <!-- Header; the chevron collapses the sidebar to a narrow strip (remembered in settings). -->
                    <DockPanel DockPanel.Dock="Top" Height="44" Margin="8,0">
                        <Button x:Name="SidebarToggle" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE76B;"
                                Click="OnToggleSidebar" ToolTip="Hide pinned" AutomationProperties.Name="Hide pinned" VerticalAlignment="Center"/>
                        <StackPanel x:Name="SidebarTitle" Orientation="Horizontal" Margin="8,0,0,0">
                            <TextBlock Text="&#xE840;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Accent}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Pinned" Style="{StaticResource Heading}" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer x:Name="PinnedScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl x:Name="PinnedList" Margin="8,0,8,8" Focusable="False" ItemTemplate="{StaticResource PinnedFull}">
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- Header (also a drag handle, like the rest of the window background). -->
                <DockPanel Margin="20,0,8,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Click="OnClose"
                            ToolTip="Close (Esc)" AutomationProperties.Name="Close" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock DockPanel.Dock="Left" Text="Asker" Style="{StaticResource Heading}" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <!-- Search: filters all saved history; Ctrl+F focuses, Esc clears. -->
                    <Grid VerticalAlignment="Center" MaxWidth="420" HorizontalAlignment="Stretch">
                        <TextBox x:Name="Search" TextChanged="OnSearchChanged" Padding="30,0,8,0" MinHeight="30" Height="30"
                                 AutomationProperties.Name="Search history"/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Muted}"
                                   VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Search history   Ctrl+F" Foreground="{DynamicResource Muted}" FontSize="13"
                                   VerticalAlignment="Center" Margin="31,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>

                <!-- Virtualized: only units on screen (plus a page of cache) are built. Needs the ScrollViewer inside the template. -->
                <ItemsControl x:Name="History" Grid.Row="1" Focusable="False"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                              ScrollViewer.ScrollChanged="OnScroll">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer x:Name="PART_Scroll" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="20,0,14,8">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,24">

                                    <!-- Day separator: before the first unit of each day. -->
                                    <Grid Margin="0,4,0,16">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowDateHeader}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Border Height="1" Background="{DynamicResource Line}" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource DatePill}" Content="{Binding DateLabel}" HorizontalAlignment="Center" Click="OnDatePill"/>
                                    </Grid>

                                    <!-- Unit header: time + name, then pin / rerun / delete (right-docked in reverse order) -->
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" Click="OnDelete"
                                                ToolTip="Delete" AutomationProperties.Name="Delete"/>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Click="OnRerun"
                                                ToolTip="Rerun" AutomationProperties.Name="Rerun"/>
                                        <Button DockPanel.Dock="Right" Click="OnPin">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Content" Value="&#xE718;"/>
                                                    <Setter Property="ToolTip" Value="Pin"/>
                                                    <Setter Property="AutomationProperties.Name" Value="Pin"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                            <Setter Property="Content" Value="&#xE840;"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                            <Setter Property="ToolTip" Value="Unpin"/>
                                                            <Setter Property="AutomationProperties.Name" Value="Unpin"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Time, StringFormat=HH:mm}" Style="{StaticResource Caption}"/>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" Foreground="{DynamicResource Text}"
                                                       Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Question: one line until expanded. -->
                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{StaticResource RadiusLarge}"
                                            Padding="6,6,6,6" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Click="OnExpand">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource Collapser}">
                                                        <Setter Property="Content" Value="&#xE70D;"/>
                                                        <Setter Property="ToolTip" Value="Expand"/>
                                                        <Setter Property="AutomationProperties.Name" Value="Expand question"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Expanded}" Value="True">
                                                                <Setter Property="Content" Value="&#xE70E;"/>
                                                                <Setter Property="ToolTip" Value="Collapse"/>
                                                                <Setter Property="AutomationProperties.Name" Value="Collapse question"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <StackPanel Grid.Column="1" Margin="6,3,8,3">
                                                <TextBlock TextWrapping="Wrap" LineHeight="22" LineStackingStrategy="BlockLineHeight">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding TitlePreview}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                                            <Setter Property="MaxHeight" Value="22"/>
                                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Expanded}" Value="True">
                                                                    <Setter Property="Text" Value="{Binding Title}"/>
                                                                    <Setter Property="MaxHeight" Value="Infinity"/>
                                                                    <Setter Property="TextTrimming" Value="None"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- Clipboard image: thumbnail when collapsed, larger when expanded. -->
                                                <Image Source="{Binding Image}" HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,6,0,0"
                                                       MouseLeftButtonDown="OnImageClick" Cursor="Hand" ToolTip="Double-click to zoom">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="MaxHeight" Value="64"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Image}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Expanded}" Value="True">
                                                                    <Setter Property="MaxHeight" Value="400"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <Border Margin="0,10,0,2" Padding="10,6" Background="{DynamicResource Surface}" CornerRadius="{StaticResource Radius}"
                                                        HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Expanded}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                                </Border>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8C8;" VerticalAlignment="Top"
                                                    ToolTip="Copy question" AutomationProperties.Name="Copy question" Tag="Question" Click="OnCopy"/>
                                        </Grid>
                                    </Border>

                                    <!-- Answer: full until collapsed to one line. -->
                                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusLarge}" Padding="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Click="OnAnswerExpand">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource Collapser}">
                                                        <Setter Property="Content" Value="&#xE70E;"/>
                                                        <Setter Property="ToolTip" Value="Collapse"/>
                                                        <Setter Property="AutomationProperties.Name" Value="Collapse answer"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AnswerCollapsed}" Value="True">
                                                                <Setter Property="Content" Value="&#xE70D;"/>
                                                                <Setter Property="ToolTip" Value="Expand"/>
                                                                <Setter Property="AutomationProperties.Name" Value="Expand answer"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <TextBlock Grid.Column="1" Text="Thinking…" Foreground="{DynamicResource Muted}" Margin="6,3,8,3">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <!-- Pulse only while waiting: a running animation keeps WPF rendering frames even when hidden. -->
                                                            <DataTrigger Binding="{Binding Result}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="Pulse">
                                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.7"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="Pulse"/>
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Grid.Column="1" Text="{Binding Result, Mode=OneWay}" Margin="6,3,8,3" AutomationProperties.Name="Answer">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource SelectableText}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AnswerCollapsed}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <TextBlock Grid.Column="1" Text="{Binding ResultPreview}" Margin="6,3,8,3" Foreground="{DynamicResource Muted}"
                                                       TextTrimming="CharacterEllipsis" LineHeight="22" LineStackingStrategy="BlockLineHeight" MaxHeight="22">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AnswerCollapsed}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8C8;" VerticalAlignment="Top"
                                                    ToolTip="Copy answer" AutomationProperties.Name="Copy answer" Tag="Answer" Click="OnCopy"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Sticky day pill: the day of the unit at the top of the view (Slack-style). -->
                <Button x:Name="StickyDate" Grid.Row="1" Style="{StaticResource DatePill}" VerticalAlignment="Top" HorizontalAlignment="Center"
                        Margin="20,4,24,0" Click="OnDatePill" Visibility="Collapsed"/>

                <!-- Jump menu, opened from any day pill. -->
                <Popup x:Name="JumpMenu" StaysOpen="False" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLarge}" Padding="6" Margin="0,6,0,0">
                        <StackPanel MinWidth="210">
                            <TextBlock Text="Jump to…" Style="{StaticResource Caption}" Margin="10,4,10,6"/>
                            <Button Style="{StaticResource ListButton}" Content="Most recent" Tag="recent" Click="OnJump"/>
                            <Button Style="{StaticResource ListButton}" Content="Last week" Tag="week" Click="OnJump"/>
                            <Button Style="{StaticResource ListButton}" Content="Last month" Tag="month" Click="OnJump"/>
                            <Button Style="{StaticResource ListButton}" Content="Last 3 months" Tag="3months" Click="OnJump"/>
                            <Border Height="1" Background="{DynamicResource Line}" Margin="4,4"/>
                            <Button Style="{StaticResource ListButton}" Content="Jump to a specific date…" Click="OnJumpPickDate"/>
                            <Calendar x:Name="JumpCalendar" Visibility="Collapsed" Margin="0,4,0,0" SelectedDatesChanged="OnJumpDate"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Empty state -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count, ElementName=History}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource Icons}" FontSize="28" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyTitle" Text="No results yet" Style="{StaticResource Heading}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock x:Name="EmptyHint" Text="Copy some text and press one of your hotkeys." Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
